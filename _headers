/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Mise en cache agressive des médias (1 an)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Mise en cache des polices, CSS et JS
# CSS et JS sont appelés avec ?v=AAAAMMJJ : changer ce numéro dans les pages HTML à chaque modification
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8